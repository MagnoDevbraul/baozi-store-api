@startuml

'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
' ATIVIDADE PRÁTICA DE DESENVOLVIMENTO WEB BACK-END - UNINTER
' Sistema: Baozi Store API
' Autor: Magno Walério Alves Ferreira
' RU: 4758995
' Descrição: Diagrama de Casos de Uso detalhando as interações do ator do sistema
'            com os endpoints dos recursos (Cliente, Produto e Pedido).
'~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

' Definição do título no diagrama
title Baozi Store API - Diagrama de Caso de Uso\nMagno Ferreira - 4758995

' Orientação do layout do diagrama (da esquerda p/ direita)
left to right direction

' Ator principal interagindo com as rotas REST da aplicação
actor "Usuário da API" as Usuario

' Limite do sistema
rectangle "Baozi Store API" {

    ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ' Módulo - Cliente
    ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rectangle "CLIENTE" as Cliente {
        usecase "Criar Cliente" as C1
        usecase "Listar Clientes" as C2
        usecase "Consultar Cliente por ID" as C3
        usecase "Atualizar Cliente" as C4
        usecase "Excluir Cliente" as C5
    }

    ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ' Módulo - Produtos
    ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rectangle "PRODUTO" as Produto {
        usecase "Criar Produto" as P1
        usecase "Listar Produtos" as P2
        usecase "Consultar Produto por ID" as P3
        usecase "Atualizar Produto" as P4
        usecase "Excluir Produto" as P5
    }

    ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ' Módulo - Pedidos
    ' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    rectangle "PEDIDO" as Pedido {
        usecase "Criar Pedido" as PD1
        usecase "Listar Pedidos" as PD2
        usecase "Consultar Pedido por ID" as PD3
        usecase "Atualizar Pedido" as PD4
        usecase "Excluir Pedido" as PD5
    }
}


' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
' Relacionamentos/Associações
' ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

' Integrações dos endpoints de Clientes
Usuario --> C1
Usuario --> C2
Usuario --> C3
Usuario --> C4
Usuario --> C5

' Integrações dos endpoints de Produtos
Usuario --> P1
Usuario --> P2
Usuario --> P3
Usuario --> P4
Usuario --> P5

' Integrações dos endpoints de Pedidos
Usuario --> PD1
Usuario --> PD2
Usuario --> PD3
Usuario --> PD4
Usuario --> PD5

@enduml